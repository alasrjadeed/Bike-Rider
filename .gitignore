# Signing identity. The release key is the app's permanent identity: if it is lost, no future
# version of Bike Rider can be installed as an update on a device that already has it, and if
# the password leaks, anyone can sign a "release" build. Back both of these up somewhere off this
# machine. Neither belongs in version control.
android/release.keystore
android/keystore.properties
android/debug.keystore

# The AppGallery Connect Method-2 upload pair. encryptedPrivateKey is a plaintext-readable private
# key; certificate.pem is public but travels with it. Never commit either.
agc-upload/

# AppGallery Connect credentials: project API key + the API client used by tools/agc-upload.mjs.
# Contains a client secret in plaintext.
.agc.env

# The pepk.jar tool and the signature-key zip it produces. The zip contains the private key.
pepk.jar
sign.zip

# Supabase. The publishable (anon) key is client-safe, but the CLI access token in
# .env is full project access and must never be committed or shipped in the APK.
.env
supabase/.temp/

# Build intermediates. Regenerated by `npm run build`; only dist/ is a release artifact.
android/build/
android/app/build/
android/build-gradle/
android/.gradle/

node_modules/
.DS_Store
